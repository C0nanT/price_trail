# Modelo do .env (nunca versionado). Na VPS: /opt/apps/price_trail/.env.
# Local: copie para .env (o Makefile carrega) e deixe DB_PATH/DATA_DIR comentados,
# para o `make serve` usar o banco e a pasta data/ do projeto.

# Usuário único do login.
AUTH_USERNAME=conan

# Hash argon2 da senha: `python -m pricetrail hash-password` (local) ou
# `docker compose run --rm web python -m pricetrail hash-password`.
# Entre aspas simples: o hash tem `$`, que o Compose (e o make) interpolariam.
AUTH_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$cole-aqui$o-hash-gerado'

# Assina o cookie de sessão; trocar derruba todas as sessões. Aleatório, ≥ 32 bytes:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-um-valor-aleatorio

# Flag Secure do cookie. 1 em produção; 0 só para testar local por HTTP.
SESSION_COOKIE_SECURE=1

# Hosts aceitos, separados por vírgula (127.0.0.1 é o do healthcheck).
ALLOWED_HOSTS=compras.conantorres.dev,localhost,127.0.0.1

# Quem pode mandar X-Forwarded-*: a sub-rede da rede `proxy` na VPS
# (`docker network inspect proxy`, campo Subnet). Local: 127.0.0.1.
FORWARDED_ALLOW_IPS=172.18.0.0/16

# Nível do log (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Só produção: banco e PDFs no volume /data (a imagem já usa esses valores).
# Local, sem eles, valem pricetrail.sqlite e data/ na raiz do projeto.
#DB_PATH=/data/app.db
#DATA_DIR=/data/pdfs

# Tag da imagem no compose: latest, ou o SHA de um commit para fixar/voltar uma versão.
IMAGE_TAG=latest

# Quantos backups do banco manter em /data/backups (`pricetrail backup`); os mais antigos são apagados.
BACKUP_KEEP=14
